APP_PORT=4173
APP_BIND=127.0.0.1
# Set to the external HTTPS origin when using a custom domain.
PUBLIC_ORIGIN=http://localhost:4173

# Generate a strong password with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-this-before-deploying
# Optional. Defaults to the isolated PostgreSQL container and the password above.
# DATABASE_URL=
# Optional host directories. Relative paths are resolved beside docker-compose.yml.
# POSTGRES_STORAGE=./data/postgres
# BACKUP_STORAGE=./data/backups

# Existing Pocket ID installation. Required for sign-in and gameplay.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to PUBLIC_ORIGIN followed by /api/auth/callback.
# OIDC_CALLBACK_URL=
# Optional Pocket ID subject to grant Admin access when that user signs in.
OIDC_ADMIN_SUBJECT=
