APP_PORT=4173
APP_BIND=127.0.0.1
# Set to the origin players use. HTTPS is recommended; HTTP works for a self-hosted LAN instance.
PUBLIC_ORIGIN=http://localhost:4173

# Generate a strong password with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-this-before-deploying
# Optional. Defaults to the isolated PostgreSQL container and the password above.
# DATABASE_URL=
# Optional host directories. Relative paths are resolved beside docker-compose.yml.
# POSTGRES_STORAGE=./data/postgres
# BACKUP_STORAGE=./data/backups

# Set false for local-only test play without Pocket ID or account sync.
LOGIN_ENABLED=true

# Daily challenges. The timezone is instance-wide; the reset time is an admin setting.
CHALLENGE_TIMEZONE=UTC
# Emergency kill switch. Set false to stop challenge scheduling and writes.
CHALLENGES_ENABLED=true
# Enable only on localhost with a separate test database. Adds a test account and role selector.
TEST_ENVIRONMENT=false

# Existing Pocket ID installation. Required when login is enabled.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to PUBLIC_ORIGIN followed by /api/auth/callback.
# OIDC_CALLBACK_URL=
# Optional Pocket ID subject to grant Admin access when that user signs in.
OIDC_ADMIN_SUBJECT=

# Comma-separated interface languages. The first is the deployment fallback.
AVIARIUM_ENABLED_LOCALES=en,nl
# Optional. Set both values to enable AI translation drafts in the admin news editor.
# AVIARIUM_TRANSLATION_MODEL=
# OPENAI_API_KEY=
